# ─────────────────────────────────────────────────────────────────────────────
# AreBet — environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Project URL — safe to expose (used in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/public key — safe to expose (protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY, never prefix with NEXT_PUBLIC_
# Required for: wallet ledger writes, bet settlement, admin actions, provider webhooks
# Found in: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ── API-Football (optional) ───────────────────────────────────────────────────
# Register at https://api-sports.io → free tier = 100 req/day
# If unset, the app runs in demo mode with simulated match data.
API_FOOTBALL_KEY=

# ── Data mode ─────────────────────────────────────────────────────────────────
# Force demo mode regardless of whether API_FOOTBALL_KEY is set.
# Set to "false" in production with a real API key.
NEXT_PUBLIC_USE_DEMO_DATA=true

# ── Real-money master switch (hard kill switch — see supabase/migrations) ────
# Master gate for ALL real-money code paths (deposits, withdrawals, real-money
# bet settlement, real-money casino rounds). Changing this requires a deploy —
# it is intentionally NOT toggleable from within the app.
#
# ⚠️ Do NOT set this to "true" until the operating entity holds a valid gambling
# license for every jurisdiction being served. Per-feature rollout (sports vs
# casino vs withdrawals) is controlled separately via the `feature_flags` table
# once this master switch is on — see lib/config/feature-flags.ts.
REAL_MONEY_ENABLED=false

# ── Admin operations ──────────────────────────────────────────────────────────
# Legacy shared-secret guard for /api/admin/boost (editorial boosts only).
# Being phased out in favor of the `admin_roles` table / requireAdminRole().
# Set to any strong random string, e.g.: openssl rand -hex 32
ADMIN_SECRET=

# ── Stripe — content subscription paywall (unrelated to betting wallet) ──────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_ELITE_PRICE_ID=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret required to call POST /api/push/notify
PUSH_NOTIFY_SECRET=

# ── Odds / casino / payments / KYC providers ─────────────────────────────────
# All four run against mock implementations by default (see lib/providers/*).
# No env vars are required for mock mode. When a real vendor is integrated,
# its credentials get added here and lib/providers/<domain>/index.ts is
# updated to resolve to the real implementation — no other code changes.
